{
  "root": ".ceramind-cone-converter",
  "notes": "Answers worked by hand from Orton's chart (theceramicshop.com/downloads/Ortonconecharttemperatures.pdf), Self Supporting Cones, Regular, 108 and 270°F/hr columns = 60 and 150°C/hr. °C = (°F - 32) x 5/9 rounded to the nearest degree; °F shown as Orton prints it. Quick convert: °F = °C x 1.8 + 32, to 0.1 degree.",
  "cases": [
    { "name": "default: cone 6 at 60°C/hr = Orton 2232°F; 2200 x 5/9 = 1222.2 > 1222°C (the same as the Firing Schedule calculator)",
      "expect": ["1222°C", "2232°F", "From Orton's cone chart, for a self-supporting cone heated at 60°C (108°F) an hour over the last 100°C."],
      "absent": ["1243", "Enter a temperature"] },
    { "name": "cone 6 at 150°C/hr = 2269°F; 2237 x 5/9 = 1242.8 > 1243°C",
      "do": [["click", "[data-rate='150']"]],
      "expect": ["1243°C", "2269°F", "heated at 150°C (270°F) an hour"], "absent": ["1222°C", "108°F"] },
    { "name": "cone 06 at 150 = 1855°F; 1823 x 5/9 = 1012.8 > 1013°C",
      "do": [["select", "[data-role=cone]", "06"]],
      "expect": ["1013°C", "1855°F"] },
    { "name": "cone 06 at 60 = 1828°F; 1796 x 5/9 = 997.8 > 998°C",
      "do": [["click", "[data-rate='60']"]],
      "expect": ["998°C", "1828°F", "heated at 60°C (108°F) an hour"], "absent": ["1013°C"] },
    { "name": "cone 04 at 60 = 1945°F; 1913 x 5/9 = 1062.8 > 1063°C",
      "do": [["select", "[data-role=cone]", "04"]],
      "expect": ["1063°C", "1945°F"] },
    { "name": "cone 9 at 60 = 2300°F; 2268 x 5/9 = 1260°C",
      "do": [["select", "[data-role=cone]", "9"]],
      "expect": ["1260°C", "2300°F"] },
    { "name": "cone 10 at 60 = 2345°F; 2313 x 5/9 = 1285°C",
      "do": [["select", "[data-role=cone]", "10"]],
      "expect": ["1285°C", "2345°F"] },
    { "name": "JULY FIX: cone 022 at 60 = 1087°F; 1055 x 5/9 = 586.1 > 586°C (the July file showed 590, the 150 figure)",
      "do": [["select", "[data-role=cone]", "022"]],
      "expect": ["586°C", "1087°F"], "absent": ["590°C"] },
    { "name": "JULY FIX: cone 022 at 150 exists = 1094°F; 1062 x 5/9 = 590°C",
      "do": [["click", "[data-rate='150']"]],
      "expect": ["590°C", "1094°F"] },
    { "name": "JULY FIX: cone 021 at 150 = 1143°F; 1111 x 5/9 = 617.2 > 617°C",
      "do": [["select", "[data-role=cone]", "021"]],
      "expect": ["617°C", "1143°F"] },
    { "name": "cone 5½ at 150 = 2237°F; 2205 x 5/9 = 1225°C",
      "do": [["select", "[data-role=cone]", "5½"]],
      "expect": ["1225°C", "2237°F"] },
    { "name": "cone 14 at 150 = 2523°F; 2491 x 5/9 = 1383.9 > 1384°C",
      "do": [["select", "[data-role=cone]", "14"]],
      "expect": ["1384°C", "2523°F"] },
    { "name": "cone 05½ at 60 = 1859°F; 1827 x 5/9 = 1015°C",
      "do": [["select", "[data-role=cone]", "05½"], ["click", "[data-rate='60']"]],
      "expect": ["1015°C", "1859°F"] },
    { "name": "°C ↔ °F with nothing typed asks for a temperature",
      "do": [["click", "[data-mode=convert]"]],
      "expect": ["Enter a temperature to convert."], "absent": [" = ", "Orton"] },
    { "name": "1222°C x 1.8 + 32 = 2231.6°F (Orton's own 2232°F is the unrounded figure)",
      "do": [["fill", "[data-role=temp]", "1222"]],
      "expect": ["1222°C = 2231.6°F", "°F = °C × 9 ÷ 5 + 32"], "absent": ["Enter a temperature"] },
    { "name": "1000°C x 1.8 + 32 = 1832°F",
      "do": [["fill", "[data-role=temp]", "1000"]],
      "expect": ["1000°C = 1832°F"] },
    { "name": "37.5°C x 1.8 + 32 = 99.5°F",
      "do": [["fill", "[data-role=temp]", "37.5"]],
      "expect": ["37.5°C = 99.5°F"] },
    { "name": "0°C = 32°F",
      "do": [["fill", "[data-role=temp]", "0"]],
      "expect": ["0°C = 32°F"] },
    { "name": "From °F reads the same number as °F: 1000°F; 968 x 5/9 = 537.78 > 537.8°C",
      "do": [["fill", "[data-role=temp]", "1000"], ["click", "[data-unit=f]"]],
      "expect": ["1000°F = 537.8°C", "°C = (°F − 32) × 5 ÷ 9"] },
    { "name": "2232°F; 2200 x 5/9 = 1222.2°C",
      "do": [["fill", "[data-role=temp]", "2232"]],
      "expect": ["2232°F = 1222.2°C"] },
    { "name": "−40°F = −40°C: (−72) x 5/9 = −40",
      "do": [["fill", "[data-role=temp]", "-40"]],
      "expect": ["−40°F = −40°C"] },
    { "name": "below absolute zero in °F is refused",
      "do": [["fill", "[data-role=temp]", "-500"]],
      "expect": ["That's below absolute zero (−459.67°F). Check the number."], "absent": [" = "] },
    { "name": "−500 read as °C is still below absolute zero",
      "do": [["click", "[data-unit=c]"]],
      "expect": ["That's below absolute zero (−273.15°C). Check the number."], "absent": [" = "] },
    { "name": "absolute zero itself is allowed: −273.15 x 1.8 + 32 = −459.67 > −459.7°F",
      "do": [["fill", "[data-role=temp]", "-273.15"]],
      "expect": ["−273.15°C = −459.7°F"], "absent": ["absolute zero"] },
    { "name": "clearing the box goes back to the prompt",
      "do": [["fill", "[data-role=temp]", ""]],
      "expect": ["Enter a temperature to convert."], "absent": [" = "] },
    { "name": "back to cones keeps the last cone and rate: cone 05½ at 60 = 1015°C",
      "do": [["click", "[data-mode=cone]"]],
      "expect": ["1015°C", "1859°F", "heated at 60°C (108°F) an hour"], "absent": ["Enter a temperature"] }
  ]
}
