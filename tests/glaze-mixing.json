   ],
   "absent": [
    "mixed bucket, not"
   ]
  },
  {
   "name": "opening it again keeps the bucket values",
   "do": [
    [
     "click",
     "[data-role=more]"
    ]
   ],
   "expect": [
    "The SG now must be above 1.00."
   ]
  },
  {
   "name": "the 1,050 g K32 batch still gives 1,032 ml after closing",
   "do": [
    [
     "click",
     "[data-role=more]"
