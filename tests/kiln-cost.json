{
  "root": ".ceramind-kiln-cost-calculator",
  "cases": [
    { "name": "default: 7 kW, bisque 8 h at 50%, 26.32p",
      "expect": ["Electricity: 28.0 kWh", "Cost: £7.37", "price cap rate for 1 Oct – 31 Dec 2026"], "absent": ["Per piece"] },
    { "name": "20 pieces",
      "do": [["fill", "[data-role=pieces]", "20"]],
      "expect": ["Per piece (20): 37p"] },
    { "name": "stoneware glaze preset: 10 h at 65%",
      "do": [["select", "[data-role=firing]", "stoneware"]],
      "expect": ["Electricity: 45.5 kWh", "Cost: £11.98", "Per piece (20): 60p"] },
    { "name": "plug-in kiln preset: 3 kW",
      "do": [["select", "[data-role=kiln]", "3"]],
      "expect": ["Electricity: 19.5 kWh", "Cost: £5.13"] },
    { "name": "Economy 7 night rate 14.5p",
      "do": [["click", "[data-rate=night]"]],
      "expect": ["Cost: £2.83", "Economy 7"] },
    { "name": "back to standard rate",
      "do": [["click", "[data-rate=cap]"]],
      "expect": ["Cost: £5.13"] },
    { "name": "dollars: price cleared, asks for a price",
      "do": [["click", "[data-cur=usd]"]],
      "expect": ["Enter your kiln power, firing time and electricity price."] },
    { "name": "dollars at 24 cents",
      "do": [["fill", "[data-role=price]", "24"]],
      "expect": ["Cost: $4.68", "Per piece (20): 23¢", "your own electricity price"] },
    { "name": "kWh reading mode, back in pounds",
      "do": [["click", "[data-cur=gbp]"], ["click", "[data-mode=reading]"], ["fill", "[data-role=kwh]", "30"]],
      "expect": ["Electricity: 30.0 kWh", "Cost: £7.90", "Per piece (20): 39p"] },
    { "name": "custom kW and hours, back to estimate",
      "do": [["click", "[data-mode=estimate]"], ["fill", "[data-role=kw]", "2.5"], ["fill", "[data-role=hours]", "6"], ["fill", "[data-role=load]", "50"], ["fill", "[data-role=pieces]", ""]],
      "expect": ["Electricity: 7.5 kWh", "Cost: £1.97"], "absent": ["Per piece"] },
    { "name": "empty power shows the prompt",
      "do": [["fill", "[data-role=kw]", ""]],
      "expect": ["Enter your kiln power, firing time and electricity price."] }
  ]
}
