{
  "root": ".ceramind-kiln-cost-calculator",
  "cases": [
    { "name": "default: 7 kW, bisque 8 h at 50%, 26.32p",
      "expect": ["Cost: £7.37", "Electricity: 28.0 kWh", "price cap rate for 1 Oct – 31 Dec 2026"], "absent": ["Per piece"] },
    { "name": "20 pieces",
      "do": [["fill", "[data-role=pieces]", "20"]],
      "expect": ["Per piece (20): 37p"] },
    { "name": "stoneware glaze preset: 10 h at 65%",
      "do": [["select", "[data-role=firing]", "stoneware"]],
      "expect": ["Cost: £11.98", "Electricity: 45.5 kWh", "Per piece (20): 60p"] },
    { "name": "plug-in kiln preset: 3 kW",
      "do": [["select", "[data-role=kiln]", "3"]],
      "expect": ["Cost: £5.13", "Electricity: 19.5 kWh"] },
    { "name": "Economy 7 night rate 14.5p",
      "do": [["click", "[data-rate=night]"]],
      "expect": ["Cost: £2.83", "Economy 7", "every hour fell in your cheap window"] },
    { "name": "back to standard rate",
      "do": [["click", "[data-rate=cap]"]],
      "expect": ["Cost: £5.13"] },
    { "name": "own price survives clicking £ again",
      "do": [["fill", "[data-role=price]", "24.5"], ["click", "[data-cur=gbp]"]],
      "expect": ["Cost: £4.78", "Per piece (20): 24p", "your own electricity price"] },
    { "name": "dollars start empty and ask for a price",
      "do": [["click", "[data-cur=usd]"]],
      "expect": ["Enter your electricity price."] },
    { "name": "dollars at 24 cents",
      "do": [["fill", "[data-role=price]", "24"]],
      "expect": ["Cost: $4.68", "Per piece (20): 23¢"] },
    { "name": "back to pounds restores 24.5p",
      "do": [["click", "[data-cur=gbp]"]],
      "expect": ["Cost: £4.78"] },
    { "name": "back to dollars restores 24 cents",
      "do": [["click", "[data-cur=usd]"]],
      "expect": ["Cost: $4.68"] },
    { "name": "pounds, standard rate button resets to the cap",
      "do": [["click", "[data-cur=gbp]"], ["click", "[data-rate=cap]"]],
      "expect": ["Cost: £5.13"] },
    { "name": "kWh reading 30",
      "do": [["click", "[data-mode=reading]"], ["fill", "[data-role=kwh]", "30"]],
      "expect": ["Cost: £7.90", "Electricity: 30.0 kWh", "Per piece (20): 39p"] },
    { "name": "99.75p rounds up to £1.00, not 100p",
      "do": [["fill", "[data-role=kwh]", "3.79"]],
      "expect": ["Cost: £1.00"], "absent": ["100p"] },
    { "name": "thousands get commas",
      "do": [["fill", "[data-role=kwh]", "10000"]],
      "expect": ["Cost: £2,632.00", "Electricity: 10,000.0 kWh"] },
    { "name": "custom kW and hours back in estimate mode",
      "do": [["click", "[data-mode=estimate]"], ["fill", "[data-role=pieces]", ""], ["fill", "[data-role=kw]", "2.5"], ["fill", "[data-role=hours]", "6"], ["fill", "[data-role=load]", "50"]],
      "expect": ["Cost: £1.97", "Electricity: 7.5 kWh"], "absent": ["Per piece"] },
    { "name": "watts typed into kW are read as watts",
      "do": [["fill", "[data-role=kw]", "3000"]],
      "expect": ["Cost: £2.37", "Electricity: 9.0 kWh", "Read 3,000 as watts: 3 kW."] },
    { "name": "average power over 100% is capped",
      "do": [["fill", "[data-role=load]", "150"]],
      "expect": ["Cost: £4.74", "can't be over 100%"] },
    { "name": "price typed in pounds is read as pence",
      "do": [["fill", "[data-role=price]", "0.2632"]],
      "expect": ["Cost: £4.74", "Read 0.2632 as £0.2632 per kWh (26.32p)."] },
    { "name": "blank power names what's missing",
      "do": [["fill", "[data-role=kw]", ""]],
      "expect": ["Enter your kiln power."] },
    { "name": "two things missing",
      "do": [["fill", "[data-role=hours]", ""]],
      "expect": ["Enter your kiln power and heating time."] }
  ]
}
