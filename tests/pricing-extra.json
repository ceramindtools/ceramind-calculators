{
  "root": ".ceramind-pricing-calculator",
  "cases": [
    { "name": "$ hints carry no UK prices",
      "do": [["click", "[data-cur=usd]"]], "in": ".cm-card",
      "expect": ["The example figures are UK prices", "divide one firing's cost by the number of pieces in the kiln", "Fees on shipping"],
      "absent": ["(£)", "90p a kg", "£11.30", "37p a mug", "£12.71", "£90,000", "National Living Wage", "postage"] },
    { "name": "£ hints come back",
      "do": [["click", "[data-cur=gbp]"]], "in": ".cm-card",
      "expect": ["500 g of clay at 90p a kg", "£11.30 a kg", "about 37p a mug", "National Living Wage", "Fees on postage"],
      "absent": ["UK prices", "divide one firing"] },
    { "name": "card reader view with a blank fee shows no chart",
      "do": [["click", "[data-view=reader]"], ["fill", "[data-role=readerpct]", ""]], "in": ".cm-split",
      "expect": ["Enter the card reader fee % to see this split."], "absent": ["Profit", "Fees", "Materials"],
      "hidden": [".cm-bar"] },
    { "name": "card fee of 150% asks to check it",
      "do": [["fill", "[data-role=readerpct]", "150"]], "in": ".cm-split",
      "expect": ["Check the card reader fee % to see this split."], "hidden": [".cm-bar"] },
    { "name": "fee back: chart returns (profit 25.15085 of 36 = 70%)",
      "do": [["fill", "[data-role=readerpct]", "1.69"]], "in": ".cm-split",
      "expect": ["Where £36.00 goes with a card reader", "Fees 61p 2%", "Profit £25.15 70%"], "visible": [".cm-bar"] },
    { "name": "a loss shows without a double negative",
      "do": [["click", "[data-view=etsy]"], ["fill", "[data-role=mult]", "1"], ["fill", "[data-role=profit]", "0"]], "in": ".cm-split",
      "expect": ["Where £11.00 goes on Etsy", "Fees £1.87", "Loss £1.11"], "absent": ["−", "Profit"] },
    { "name": "screen reader line gives the result",
      "do": [["fill", "[data-role=mult]", "2"], ["fill", "[data-role=profit]", "75"]], "wait": 1000, "in": ".cm-sr",
      "expect": ["Wholesale £18.00, retail £36.00."] },
    { "name": "a result pending when a field is blanked is never read out",
      "do": [["fill", "[data-role=hours]", "1"], ["fill", "[data-role=hours]", ""]], "wait": 1000, "in": ".cm-sr",
      "expect": ["Enter your hours on this piece."], "absent": ["Wholesale"] },
    { "name": "back to a result",
      "do": [["fill", "[data-role=hours]", "0.5"]], "wait": 1000, "in": ".cm-sr",
      "expect": ["Wholesale £18.00, retail £36.00."] },
    { "name": "card fee error is read out",
      "do": [["fill", "[data-role=readerpct]", "150"]], "wait": 1000, "in": ".cm-sr",
      "expect": ["A card fee can't be 100% or more"] },
    { "name": "example untouched: offer to clear it",
      "do": [["fill", "[data-role=readerpct]", "1.69"]], "in": ".cm-example",
      "expect": ["It opens on an example mug.", "Clear the example"], "visible": ["[data-role=example]"] },
    { "name": "own figures typed after clearing: no button that could wipe them",
      "do": [["click", "[data-role=example]"], ["fill", "[data-role=clay]", "2"], ["fill", "[data-role=glaze]", "0.50"], ["fill", "[data-role=hours]", "1"]],
      "in": ".cm-example", "expect": ["Using your own figures."], "hidden": ["[data-role=example]"] },
    { "name": "editing one example figure also hides the button",
      "do": [["fill", "[data-role=clay]", "0.45"], ["fill", "[data-role=glaze]", "1.13"], ["fill", "[data-role=bisque]", "0.37"], ["fill", "[data-role=glazefire]", "0.60"], ["fill", "[data-role=hours]", "0.75"]],
      "in": ".cm-example", "expect": ["Using your own figures."], "hidden": ["[data-role=example]"] },
    { "name": "all fields empty: offer to put the example back",
      "do": [["fill", "[data-role=clay]", ""], ["fill", "[data-role=glaze]", ""], ["fill", "[data-role=bisque]", ""], ["fill", "[data-role=glazefire]", ""], ["fill", "[data-role=hours]", ""]],
      "in": ".cm-example", "expect": ["Add your own figures for one piece.", "Put the example back"], "visible": ["[data-role=example]"] },
    { "name": "putting it back restores the mug",
      "do": [["click", "[data-role=example]"]], "in": ".cm-results",
      "expect": ["Cost to make: £10.24", "Retail: £36.00"] }
  ]
}
